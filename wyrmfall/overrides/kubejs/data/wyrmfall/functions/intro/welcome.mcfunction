give @s minecraft:written_book{title:"Survivors Journal",author:"The Last One",generation:3,display:{Lore:['{"text":"Read me before nightfall.","color":"dark_red","italic":true}']},pages:['["", {"text": "\\n   WYRMFALL\\n", "color": "dark_red", "bold": true}, {"text": "  Survivors Journal\\n\\n", "color": "dark_gray", "italic": true}, {"text": "The dragons came back.\\n\\nThe sky has burned for a hundred years. The towns are ash. The roads are bones.\\n\\n", "color": "black"}, {"text": "You woke up with nothing. Keep this book.", "color": "dark_red"}]','["", {"text": "RULES OF THE FALL\\n\\n", "color": "dark_red", "bold": true}, {"text": "❤ You start with ", "color": "black"}, {"text": "6 hearts", "color": "red", "bold": true}, {"text": ".\\n\\n", "color": "black"}, {"text": "☠ Hard difficulty. Always.\\n\\n", "color": "black"}, {"text": "☠ Each death withers one heart you earned.\\n\\n", "color": "black"}, {"text": "☠ Your gear stays on your corpse. Go back for it.", "color": "black"}]','["", {"text": "HEART CRYSTALS\\n\\n", "color": "dark_red", "bold": true}, {"text": "Monsters sometimes drop a ", "color": "black"}, {"text": "Heart Shard", "color": "dark_purple"}, {"text": ".\\n\\n", "color": "black"}, {"text": "4 shards around a golden apple = 1 ", "color": "black"}, {"text": "Heart Crystal", "color": "red"}, {"text": ".\\n\\n", "color": "black"}, {"text": "Bosses drop crystals. Apex beasts drop two.\\n\\nRight-click a crystal: +1 heart, up to 20.", "color": "black"}]','["", {"text": "THE LAND\\n\\n", "color": "dark_red", "bold": true}, {"text": "Your body has a temperature. Dress for the cold, find shade in the heat.\\n\\n", "color": "black"}, {"text": "Dirty water makes you sick. Purify it.\\n\\n", "color": "black"}, {"text": "Seasons turn. Winter is long. Store food.", "color": "black"}]','["", {"text": "THE NIGHT\\n\\n", "color": "dark_red", "bold": true}, {"text": "When the moon turns red, ", "color": "black"}, {"text": "the horde comes", "color": "dark_red", "bold": true}, {"text": ". Be inside. Be lit. Be ready.\\n\\n", "color": "black"}, {"text": "Monsters break doors. Some break walls.\\n\\n", "color": "black"}, {"text": "Waystones are the only safe roads.", "color": "black"}]','["", {"text": "LAST ENTRY\\n\\n", "color": "dark_red", "bold": true}, {"text": "Dragons nest in the mountains and in the frozen north. Their hoards are real.\\n\\n", "color": "black"}, {"text": "So are their teeth.\\n\\n", "color": "black"}, {"text": "Do not go to them until your heart is strong.\\n\\n", "color": "black"}, {"text": "    - the last one\\n       who did", "color": "dark_gray", "italic": true}]']} 1
