{
  "name": "orbit-network-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Orbit Network Hub: 3D space gaming portal and Orbitnetwork.net Minecraft server site.",
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o site/css/tailwind.css --minify",
    "build:assets": "node scripts/copy-assets.js",
    "build:wordmarks": "node scripts/build-wordmarks.mjs",
    "build": "npm run build:assets && npm run build:wordmarks && npm run build:css",
    "serve": "python3 -m http.server 8080 --directory site"
  },
  "devDependencies": {
    "@fontsource-variable/exo-2": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/sacramento": "5.3.0",
    "opentype.js": "1.3.4",
    "tailwindcss": "3.4.19",
    "three": "0.170.0"
  }
}
