{
  "schemaVersion": 1,
  "id": "lyrichud",
  "version": "${version}",
  "name": "Lyric HUD",
  "description": "Shows synced lyrics for whatever is playing in Spotify, YouTube Music or YouTube, in 3D in the top-right corner of the screen.",
  "authors": ["gamershoam"],
  "license": "MIT",
  "icon": "assets/lyrichud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.lyrichud.LyricHudClient"]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
